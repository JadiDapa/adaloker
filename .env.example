# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adaloker?schema=public"

# Clerk — self-serve sign-up/sign-in. Ambil dari dashboard.clerk.com.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Signing secret webhook (dashboard.clerk.com > Webhooks > endpoint
# /api/webhooks/clerk, subscribe ke user.created/user.updated/user.deleted).
CLERK_WEBHOOK_SIGNING_SECRET=""

# Gemini — dipakai untuk fitur "AI dump" (textarea bebas -> field terstruktur)
# di lamaran kerja & profil pribadi. Satu key ini dipakai bersama untuk semua
# user (bukan bring-your-own-key), lihat lib/gemini.ts.
GEMINI_API_KEY=""

# UploadThing — file storage untuk resume PDF (profil) & lampiran lamaran kerja.
# Ambil dari dashboard.uploadthing.com > App > API Keys (format token v7, bukan
# UPLOADTHING_SECRET lama). Lihat app/api/uploadthing/core.ts.
UPLOADTHING_TOKEN=""

# WhatsApp bot (whatsapp-bot/, jalankan terpisah lewat `npm run bot:whatsapp`).
# Reuse DATABASE_URL & GEMINI_API_KEY di atas — tidak butuh key baru, cuma scan
# QR sekali (tersimpan di whatsapp-bot/auth/, jangan di-commit).
# WHATSAPP_LOG_LEVEL="warn"
